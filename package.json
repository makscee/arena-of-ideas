{
  "name": "arena-of-ideas",
  "version": "5.0.0-alpha.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:browser": "node e2e/run.mjs --check-browser",
    "e2e:serve": "node e2e/run.mjs --serve",
    "e2e:stop": "node e2e/run.mjs --down",
    "probe": "node e2e/probe.mjs",
    "typecheck": "tsc --noEmit",
    "battle": "node --import tsx/esm src/cli.ts",
    "check-candidate": "node --import tsx/esm src/check-candidate.ts",
    "create": "node --import tsx/esm src/create/cli.ts",
    "mint-candidate": "node --import tsx/esm src/create/mint-candidate.ts",
    "approve": "node --import tsx/esm src/create/approve-cli.ts",
    "govern": "node --import tsx/esm server/src/govern-cli.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mvp:dev": "vite --config mobile/vite.config.ts",
    "mvp:build": "vite build --config mobile/vite.config.ts",
    "mvp:server": "node --import tsx/esm server/src/mvp/main.ts",
    "mvp:invite": "node --import tsx/esm server/src/mvp/invite-cli.ts",
    "mvp:invite-e2e": "node e2e/mvp-invite.mjs",
    "mvp:bot": "node --import tsx/esm e2e/mvp-api-bot.ts",
    "mvp:phone": "node e2e/mvp-phone.mjs",
    "mvp:desktop": "node e2e/mvp-desktop.mjs",
    "mvp:ideas-phone": "node e2e/mvp-ideas-phone.mjs",
    "mvp:terms": "node e2e/probe-terms-desktop.mjs",
    "mvp:beats": "node e2e/beat-frames.mjs",
    "mvp:now-sheet": "node e2e/probe-now-sheet.mjs",
    "mvp:cause": "node e2e/probe-cause.mjs",
    "mvp:fusion-names": "node --import tsx/esm e2e/mvp-fusion-names.ts",
    "mvp:redeploy": "scripts/mvp-redeploy.sh",
    "mvp:meta": "node --import tsx/esm scripts/meta-health.ts",
    "mvp:tune": "node --import tsx/esm scripts/tune-unit.ts",
    "mvp:texts": "node --import tsx/esm scripts/unit-texts.ts",
    "mvp:check": "npm run -s typecheck && npm test && npm run -s mvp:bot -- --runs 50 && npm run -s mvp:phone && npm run -s mvp:desktop && npm run -s mvp:ideas-phone && npm run -s mvp:terms"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "playwright": "^1.60.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.0"
  }
}
