node_modules/
dist/

# Creation-worker output — a worker emits its candidate here per task; the
# committed golden inputs live in tasks/*/fixtures/, never clobbered.
tasks/*/out/

# Screenshot/motion evidence — deterministic per-task paths, never committed.
e2e/.evidence/
e2e/.shots/
e2e/.shots-challenge/

# Local runtime SQLite state; production uses a named volume.
data/arena.db*

# Warm-stack pidfile written by `npm run e2e:serve`, read by `npm run e2e:stop`.
.e2e-serve.json
