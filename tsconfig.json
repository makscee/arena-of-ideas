{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "clients", "web", "mobile", "server/src", "scripts", "e2e/mvp-api-bot.ts", "e2e/mvp-own-crown.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["clients/claude-code/hooks", "clients/claude-code/tests", "clients/claude-code/types", "clients/claude-code/.claude-plugin"]
}
